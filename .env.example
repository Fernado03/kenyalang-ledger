# Copy to .env for reference only: the backend does not autoload dotenv files.
# Export these variables in your shell (or set them in docker-compose.yml).

# Required: demo auth only runs in local/test. Unset or any other value -> 401.
# "production" makes application startup fail closed.
KENYALANG_ENV=local

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
KENYALANG_LLM_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./kenyalang.db
KENYALANG_STORAGE_ROOT=storage
KENYALANG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR runtime
EASYOCR_USE_GPU=0
KENYALANG_OCR_MIN_CONFIDENCE=0.10
